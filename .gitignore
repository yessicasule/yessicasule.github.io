# dependencies
node_modules/

# build output
site/dist/
site/*.tsbuildinfo

# personal source documents — originals stay on disk, not in the repo.
# Anything the site actually serves lives in site/public/assets/.
*.pdf
*.jpg
*.jpeg
*.png
!site/public/**
!site/src/**

# working folder of raw project captures — optimised copies that the site
# actually shows belong in site/public/assets/shots/
/Project Screenshots/
*.mp4
*.mov

# stray lockfile at the repo root (the real one is site/package-lock.json)
/package-lock.json
